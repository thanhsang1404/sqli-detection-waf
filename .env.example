# ----- MySQL -----
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=sqli_demo
MYSQL_USER=sqli_user
MYSQL_PASSWORD=change_me_password

# ----- WAF -----
THRESHOLD=0.9
MAXLEN=50
SOC_ENABLED=1
TF_MODEL_NAME=sqli

# ----- Web App -----
DB_HOST=db
DB_USER=sqli_user
DB_PASSWORD=change_me_password
DB_NAME=sqli_demo

# ----- MiniSOC -----
SOC_DB_PATH=/app/data/alerts.db
